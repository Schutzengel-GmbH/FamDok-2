# Single source of configuration for local dev, `npm run dev`, and both
# docker-compose files. Copy this to `.env` (repo root) and adjust as needed:
#   cp .env.example .env

# ── Application Postgres DB (app-db) ─────────────────────────────────────
POSTGRES_DB=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres # CHANGE for real deployments

# Full connection string, used when the backend runs OUTSIDE Docker (host dev
# via `npm run dev`) and by the Prisma CLI locally. Keep in sync with
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB above - docker-compose.yaml
# overrides this automatically for the fully-containerized backend.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/db

# ── Keycloak's own Postgres DB (keycloak-db) ─────────────────────────────
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=secret # CHANGE for real deployments

# ── Keycloak admin console / admin API login ─────────────────────────────
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin # CHANGE for real deployments

# ── Keycloak network location ─────────────────────────────────────────────
# 8090, not 8080: docker-compose.yaml's full stack also publishes the
# frontend on host port 8080, so Keycloak needs a different host port when
# both run together. docker-compose-dev.yaml has no frontend container, so
# 8080 would be fine there alone - but this file is shared by both, and 8090
# is safe for either.
KEYCLOAK_PORT=8090

# Externally-reachable Keycloak base URL (browser + host-run backend dev).
KC_BASE_URL=http://localhost:8090

# Changing these ALSO requires manually editing
# shared/keycloak-config/realm-import.json (out of scope to templatize).
KC_REALM=fh-realm
KC_CLIENT=fh-app

# ── Backend / frontend own URLs ───────────────────────────────────────────
API_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:4200 # used by backend for CORS origin

# ── Misc backend behavior ─────────────────────────────────────────────────
PRODUCTION=false
UPLOAD_DIR=./uploads # docker-compose.yaml overrides this
# to /app/dist/uploads for the container
MAX_UPLOAD_SIZE_MB=25

# NOTE: backend/prisma/seed-prod.config.json (gitignored, template:
# backend/prisma/seed-prod.config.example.json) is a separate config surface
# for one-time production seed data (org name, initial admin identity) and is
# intentionally not folded into this file.
